# Cloudflare Pages custom headers
# /_astro/ assets have content-hashed filenames — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images are stable but not hashed — cache a week instead of the 4h default.
/images/*
  Cache-Control: public, max-age=604800

# Lead-magnet PDFs change rarely.
/downloads/*
  Cache-Control: public, max-age=604800
