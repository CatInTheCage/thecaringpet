---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<!-- N6 Newspaper masthead (design.md § Nav & footer) -->
<header class="site-header">
	<div class="container masthead">
		<p class="mast-tagline">Research-backed pet feeding guides</p>
		<a href="/" class="mast-wordmark">
			<img class="mast-logo" src="/images/bowl-logo.png" alt="" width="40" height="40" decoding="async" />
			<span class="mast-name">{SITE_TITLE}</span>
		</a>

		<button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" id="menu-toggle">
			Menu
		</button>

		<nav class="mast-nav" id="nav-links" aria-label="Main navigation">
			<ul>
				<li><HeaderLink href="/categories/best-picks/">Best Picks</HeaderLink></li>
				<li><HeaderLink href="/categories/pet-knowledge/">Pet Knowledge</HeaderLink></li>
				<li><HeaderLink href="/categories/problem-solving/">Problem Solving</HeaderLink></li>
				<li><HeaderLink href="/categories/care-guides/">Care Guides</HeaderLink></li>
				<li><HeaderLink href="/tools/">Tools</HeaderLink></li>
				<li><HeaderLink href="/blog/">Articles</HeaderLink></li>
				<li><HeaderLink href="/about/">About</HeaderLink></li>
				<li>
					<a href="/search/" class="mast-search" aria-label="Search articles">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<span class="mast-search-label">Search</span>
					</a>
				</li>
			</ul>
		</nav>
	</div>
	<hr class="mast-rule" aria-hidden="true" />
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const navLinks = document.getElementById('nav-links');

	if (menuToggle && navLinks) {
		menuToggle.addEventListener('click', () => {
			const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
			menuToggle.setAttribute('aria-expanded', String(!isExpanded));
			navLinks.classList.toggle('is-open');
		});
	}
</script>

<style>
	.site-header {
		background-color: hsl(var(--background));
	}

	.masthead {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-top: var(--spacing-lg);
	}

	.mast-tagline {
		font-size: 0.75rem;
		font-variant: small-caps;
		letter-spacing: 0.12em;
		color: hsl(var(--muted-foreground));
		margin: 0 0 var(--spacing-xs);
	}

	.mast-wordmark {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
	}

	.mast-wordmark:hover {
		text-decoration: none;
		opacity: 0.85;
	}

	.mast-logo {
		width: 2.5rem;
		height: 2.5rem;
		object-fit: contain;
		flex-shrink: 0;
	}

	.mast-name {
		font-family: var(--font-heading);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		color: hsl(var(--foreground));
		white-space: nowrap;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.menu-toggle {
		display: none;
		background: none;
		border: 1px solid hsl(var(--border));
		border-radius: var(--radius-button);
		padding: 0.5rem 1.25rem;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		font-variant: small-caps;
		letter-spacing: 0.08em;
		color: hsl(var(--foreground));
		cursor: pointer;
		transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
	}

	.menu-toggle:hover {
		border-color: hsl(var(--primary));
		color: hsl(var(--primary));
	}

	.mast-nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.125rem;
		list-style: none;
		padding: 0;
		margin: var(--spacing-md) 0 0;
	}

	.mast-nav :global(a) {
		display: inline-block;
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-sm);
		color: hsl(var(--muted-foreground));
		font-size: 0.95rem;
		font-weight: 500;
		white-space: nowrap;
		transition: color var(--dur-short) var(--ease-out);
	}

	.mast-nav :global(a:hover) {
		color: hsl(var(--primary));
		text-decoration: none;
	}

	.mast-nav :global(a.active) {
		color: hsl(var(--primary));
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.mast-nav :global(a.mast-search) {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.mast-nav :global(a.mast-search svg) {
		display: block;
		flex-shrink: 0;
	}

	.mast-rule {
		border: 0;
		border-top: 1px solid hsl(var(--border));
		border-bottom: 1px solid hsl(var(--border));
		height: 3px;
		margin: var(--spacing-md) 0 0;
	}

	@media (max-width: 768px) {
		.masthead {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: center;
			text-align: left;
			padding-top: var(--spacing-md);
			padding-bottom: var(--spacing-md);
		}

		.mast-tagline {
			display: none;
		}

		.mast-logo {
			width: 1.75rem;
			height: 1.75rem;
		}

		.mast-name {
			font-size: 1.3rem;
		}

		.menu-toggle {
			display: block;
			margin-top: 0;
		}

		.mast-nav {
			display: none;
			flex-basis: 100%;
			width: 100%;
		}

		.mast-nav.is-open {
			display: block;
		}

		.mast-nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin-top: var(--spacing-md);
			border-top: 1px solid hsl(var(--border));
		}

		.mast-nav :global(a) {
			display: block;
			width: 100%;
			padding: var(--spacing-sm) var(--spacing-xs);
			border-bottom: 1px solid hsl(var(--border));
			border-radius: 0;
			text-align: left;
		}

		.mast-search {
			display: flex;
		}
	}
</style>
