---
import { AMAZON_ASSOCIATES_TAG, SITE_URL } from '../consts.ts';

interface Props {
	product: {
		name: string;
		rating: string;
		reviews: string;
		image: string;
		bestFor: string;
		material: string;
		capacity: string;
		price: string;
		pros: string[];
		cons: string[];
		amazonId: string;
		brand?: string;
	};
	badge?: string;
}

const { product, badge } = Astro.props;

// Brand extraction for the schema.org `brand` field (one of the global
// identifiers Google asks for). Most card names lead with the brand; a few
// carry it in parentheses ("...(Neareal, 74oz)"). Matched as whole words,
// case-insensitively, so "Pet Parents" never trips on "PETKIT" or "PetSafe".
const KNOWN_BRANDS: Array<[pattern: string, canonical: string]> = [
	['nina ottosson by outward hound', 'Nina Ottosson by Outward Hound'],
	['arm & hammer', 'ARM & HAMMER'],
	['best friends by sheri', 'Best Friends by Sheri'],
	['midwest homes for pets', 'MidWest Homes for Pets'],
	['rocco & roxie', 'Rocco & Roxie'],
	['amazon basics', 'Amazon Basics'],
	['outward hound', 'Outward Hound'],
	['closer pets', 'Closer Pets'],
	['cat mate', 'Cat Mate'],
	['petfusion', 'PetFusion'],
	['pet parents', 'Pet Parents'],
	['pet lodge', 'Pet Lodge'],
	['petsafe', 'PetSafe'],
	['petlibro', 'PETLIBRO'],
	['petkit', 'PETKIT'],
	['lickimat', 'LickiMat'],
	['go cat', 'Go Cat'],
	['gocat', 'Go Cat'],
	['le tauci', 'LE TAUCI'],
	['inaba', 'INABA'],
	['feliway', 'FELIWAY'],
	['feelneedy', 'FEELNEEDY'],
	['neareal', 'Neareal'],
	['vivifying', 'Vivifying'],
	['honomastry', 'Honomastry'],
	['mateeylife', 'MateeyLife'],
	['maohegou', 'Maohegou'],
	['lusifaco', 'Lusifaco'],
	['surefeed', 'SureFeed'],
	['west paw', 'West Paw'],
	['awoof', 'AWOOF'],
	['kong', 'KONG'],
	['sodapup', 'SodaPup'],
	['veken', 'Veken'],
	['churu', 'INABA'],
	['xiaz', 'XIAZ'],
	['y yhy', 'Y YHY'],
	['yopsi', 'YOPSI'],
	['k&h', 'K&H'],
];

function extractBrand(name: string): string | null {
	const lower = name.toLowerCase();
	for (const [pattern, canonical] of KNOWN_BRANDS) {
		const escaped = pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
		if (new RegExp(`\\b${escaped}\\b`).test(lower)) return canonical;
	}
	return null;
}

// JSON-LD: emit Product schema only when the visible card data parses cleanly,
// so the markup always mirrors what is actually rendered.
const priceMatch = product.price.match(/\$?\s*([\d,]+(?:\.\d+)?)/);
const priceValue = priceMatch ? parseFloat(priceMatch[1].replace(/,/g, '')) : null;
const ratingValue = Number.parseFloat(product.rating);
const reviewMatch = product.reviews.match(/[\d,]+/);
const reviewCount = reviewMatch ? parseInt(reviewMatch[0].replace(/,/g, ''), 10) : null;

const amazonUrl = `https://www.amazon.com/dp/${product.amazonId}/?tag=${AMAZON_ASSOCIATES_TAG}`;

let schemaJson: Record<string, unknown> | null = null;
if (priceValue && Number.isFinite(ratingValue) && reviewCount) {
	// We are an affiliate: the purchase happens on Amazon, so the offer-level
	// policy fields describe Amazon's standard US terms (30-day return window,
	// free returns by mail, Prime/free-shipping-eligible) and link to Amazon's
	// policy pages rather than inventing our own.
	const brandName = product.brand ?? extractBrand(product.name);
	schemaJson = {
		'@context': 'https://schema.org',
		'@type': 'Product',
		name: product.name,
		image: `${SITE_URL}${product.image}`,
		description: product.bestFor,
		sku: product.amazonId,
		...(brandName
			? { brand: { '@type': 'Brand', name: brandName } }
			: // Generic no-name listings have no brand to declare; the ASIN serves
			  // as the product identifier so the offer still carries a global ID.
				{ mpn: product.amazonId }),
		offers: {
			'@type': 'Offer',
			url: amazonUrl,
			priceCurrency: 'USD',
			price: priceValue.toFixed(2),
			availability: 'https://schema.org/InStock',
			itemCondition: 'https://schema.org/NewCondition',
			hasMerchantReturnPolicy: {
				'@type': 'MerchantReturnPolicy',
				applicableCountry: 'US',
				returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
				merchantReturnDays: 30,
				returnMethod: 'https://schema.org/ReturnByMail',
				url: 'https://www.amazon.com/returns',
			},
			shippingDetails: {
				'@type': 'OfferShippingDetails',
				shippingDestination: {
					'@type': 'DefinedRegion',
					addressCountry: 'US',
				},
				shippingRate: {
					'@type': 'MonetaryAmount',
					value: '0',
					currency: 'USD',
				},
				deliveryTime: {
					'@type': 'ShippingDeliveryTime',
					handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
					transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 5, unitCode: 'DAY' },
				},
			},
		},
		aggregateRating: {
			'@type': 'AggregateRating',
			ratingValue: ratingValue,
			bestRating: 5,
			reviewCount: reviewCount,
		},
	};
}
---

<article class="product-card">
	{schemaJson && <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaJson)} />}
	<div class="product-image">
		<img src={product.image} alt={product.name} loading="lazy" />
		{badge && <span class="badge badge-primary product-badge">{badge}</span>}
	</div>
	<div class="product-info">
		<h3>{product.name}</h3>
		<div class="product-meta">
			<span class="rating"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg> {product.rating}</span>
			<span class="reviews">({product.reviews} reviews)</span>
			<span class="price">{product.price}</span>
		</div>
		<div class="product-specs">
			<p><strong>Best For:</strong> {product.bestFor}</p>
			<p><strong>Material:</strong> {product.material}</p>
			<p><strong>Capacity:</strong> {product.capacity}</p>
		</div>
		<div class="pros-cons">
			<div class="pros">
				<h4>What We Like</h4>
				<ul>
					{product.pros.map((pro) => <li>{pro}</li>)}
				</ul>
			</div>
			<div class="cons">
				<h4>What We Don't Like</h4>
				<ul>
					{product.cons.map((con) => <li>{con}</li>)}
				</ul>
			</div>
		</div>
		<a
			href={`https://www.amazon.com/dp/${product.amazonId}/?tag=${AMAZON_ASSOCIATES_TAG}`}
			class="btn btn-primary product-cta"
			target="_blank"
			rel="sponsored noopener"
			data-product-id={product.amazonId}
		>
			Check Price on Amazon
		</a>
	</div>
</article>

<style>
	.product-card {
		background-color: hsl(var(--card));
		border-radius: var(--radius-card);
		overflow: hidden;
		box-shadow: var(--shadow-card);
		margin: var(--spacing-xl) 0;
		border: 1px solid hsl(var(--border));
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.product-card:hover {
		box-shadow: var(--shadow-card-hover);
	}

	.product-image {
		position: relative;
		background-color: hsl(var(--background));
		padding: var(--spacing-xl);
		text-align: center;
	}

	.product-image img {
		max-height: 240px;
		width: auto;
		object-fit: contain;
		border-radius: var(--radius-md);
	}

	.product-badge {
		position: absolute;
		top: var(--spacing-md);
		left: var(--spacing-md);
	}

	.product-info {
		padding: var(--spacing-xl);
	}

	.product-info h3 {
		margin-bottom: var(--spacing-sm);
		font-size: 1.25rem;
	}

	.product-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm) var(--spacing-md);
		margin-bottom: var(--spacing-md);
		font-size: 0.95rem;
	}

	.rating {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-weight: 600;
		color: hsl(38 92% 50%);
	}

	.rating svg {
		width: 1rem;
		height: 1rem;
	}

	.reviews {
		color: hsl(var(--muted-foreground));
	}

	.price {
		color: hsl(var(--primary));
		font-weight: 700;
	}

	.product-specs {
		background-color: hsl(var(--background));
		padding: var(--spacing-md);
		border-radius: var(--radius-md);
		margin-bottom: var(--spacing-md);
	}

	.product-specs p {
		margin: 0 0 var(--spacing-xs) 0;
		font-size: 0.95rem;
	}

	.product-specs p:last-child {
		margin-bottom: 0;
	}

	.pros-cons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.pros-cons h4 {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: var(--spacing-sm);
	}

	.pros h4 {
		color: hsl(var(--secondary-dark));
	}

	.cons h4 {
		color: hsl(var(--primary-dark));
	}

	.pros-cons ul {
		margin: 0;
		padding-left: var(--spacing-md);
	}

	.pros-cons li {
		font-size: 0.9rem;
		margin-bottom: var(--spacing-xs);
	}

	.product-cta {
		width: 100%;
	}

	@media (max-width: 640px) {
		.pros-cons {
			grid-template-columns: 1fr;
		}
	}
</style>
