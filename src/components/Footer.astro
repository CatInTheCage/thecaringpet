---
import { SITE_TITLE } from '../consts';
import NewsletterForm from './NewsletterForm.astro';
const today = new Date();
---

<!-- Ft7 Newsletter-first (design.md § Nav & footer) -->
<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-news">
			<img src="/images/footer-mascot.png" alt="" class="footer-mascot" loading="lazy" />
			<div class="footer-news-body">
				<h2 class="footer-news-title">Get the free checklist</h2>
				<NewsletterForm
					title=""
					description="Join thoughtful pet owners getting research-backed feeding tips. The Dog Feeding Safety Checklist PDF lands instantly."
					buttonText="Get Free Checklist"
					compact={true}
				/>
			</div>
		</div>

		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/categories/best-picks/">Best Picks</a>
			<a href="/categories/pet-knowledge/">Pet Knowledge</a>
			<a href="/categories/problem-solving/">Problem Solving</a>
			<a href="/categories/care-guides/">Care Guides</a>
			<a href="/tools/">Tools</a>
			<a href="/blog/">Articles</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
			<a href="https://pinterest.com/thecaringpet" target="_blank" rel="noopener">Pinterest</a>
			<a href="/rss.xml">RSS</a>
		</nav>

		<p class="footer-meta">
			&copy; {today.getFullYear()} {SITE_TITLE} · Reader-supported — we may earn a commission at no cost to you · <a href="/affiliate-disclosure/">Affiliate Disclosure</a> · <a href="/privacy-policy/">Privacy Policy</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid hsl(var(--border));
		padding: var(--spacing-3xl) 0 var(--spacing-xl);
		margin-top: auto;
	}

	.footer-inner {
		display: grid;
		gap: var(--spacing-2xl);
	}

	.footer-news {
		display: flex;
		align-items: center;
		gap: var(--spacing-2xl);
		max-width: 640px;
	}

	.footer-mascot {
		width: 150px;
		height: auto;
		flex-shrink: 0;
	}

	.footer-news-body {
		flex: 1;
		min-width: 0;
	}

	.footer-news-title {
		font-size: 1.75rem;
		margin-bottom: var(--spacing-sm);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		padding-top: var(--spacing-xl);
		border-top: 1px solid hsl(var(--border));
	}

	.footer-links a {
		color: hsl(var(--muted-foreground));
		font-size: 0.9rem;
		white-space: nowrap;
		transition: color var(--dur-short) var(--ease-out);
	}

	.footer-links a:hover {
		color: hsl(var(--primary));
		text-decoration: none;
	}

	.footer-meta {
		font-size: 0.8rem;
		color: hsl(var(--muted-foreground));
		margin: 0;
	}

	.footer-meta a {
		color: hsl(var(--muted-foreground));
		text-decoration: underline;
	}

	.footer-meta a:hover {
		color: hsl(var(--primary));
	}

	@media (max-width: 640px) {
		.footer-news {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-lg);
		}

		.footer-mascot {
			width: 96px;
		}

		.footer-links {
			gap: 0.5rem 1rem;
		}
	}
</style>
