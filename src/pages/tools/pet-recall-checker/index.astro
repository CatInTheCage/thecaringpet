---
import Page from '../../../layouts/Page.astro';
import PoisonHotlines from '../../../components/PoisonHotlines.astro';
import ToxinDisclaimer from '../../../components/ToxinDisclaimer.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { recalls } from '../../../data/recalls';
import { SITE_URL } from '../../../consts';
import type { RecallStatus } from '../../../types/recall';

const title = 'Pet Food Recall Checker';
const description = 'Enter a brand, product, or lot code to check your pet food against every verified FDA recall and advisory since 2025. Free, no sign-up.';
const image = '/images/hero.jpg';

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Tools', href: '/tools/' },
	{ label: 'Pet Food Recall Checker', href: '/tools/pet-recall-checker/' },
];

const statusFilters: { slug: RecallStatus | 'all'; label: string }[] = [
	{ slug: 'all', label: 'All' },
	{ slug: 'active', label: 'Active' },
	{ slug: 'fda-advisory', label: 'FDA Advisories' },
	{ slug: 'terminated', label: 'Terminated' },
];

const speciesFilters: { slug: 'all' | 'dog' | 'cat'; label: string }[] = [
	{ slug: 'all', label: 'All pets' },
	{ slug: 'dog', label: 'Dogs' },
	{ slug: 'cat', label: 'Cats' },
];

const statusLabel: Record<RecallStatus, string> = {
	active: 'Active',
	'fda-advisory': 'FDA Advisory',
	terminated: 'Terminated',
};

const categoryLabel: Record<string, string> = {
	'dog-food': 'Dog food',
	'cat-food': 'Cat food',
	'pet-food': 'Dog & cat food',
	'dog-treat': 'Dog treat',
	supplement: 'Supplement',
	other: 'Other',
};

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (iso: string) => {
	const [y, m, d] = iso.split('-').map(Number);
	return `${MONTHS[m - 1]} ${d}, ${y}`;
};

// Bucket free-text hazard strings into a small, scannable filter list.
function hazardBucket(hazard: string): string {
	const s = hazard.toLowerCase();
	if (/salmonella/.test(s) && /listeria/.test(s)) return 'Salmonella & Listeria';
	if (/salmonella/.test(s)) return 'Salmonella';
	if (/listeria/.test(s)) return 'Listeria';
	if (/h5n1|avian|bird flu/.test(s)) return 'H5N1 (Bird flu)';
	if (/thiamine|vitamin b1/.test(s)) return 'Low thiamine (Vitamin B1)';
	if (/vitamin d/.test(s)) return 'Vitamin D imbalance';
	if (/foreign|metal|plastic|choking/.test(s)) return 'Foreign material';
	if (/bacteri|e\.?\s?coli|campylobacter|leptospira/.test(s)) return 'Harmful bacteria';
	if (/nutrient|deficien|potassium|copper|folic|choline|vitamin b6/.test(s)) return 'Nutrient deficiency';
	if (/aflatoxin|mycotoxin|mold/.test(s)) return 'Mycotoxin / mold';
	return 'Other';
}

const hazardOptions = [...new Set(recalls.map((r) => hazardBucket(r.hazard)))].sort();
const brandCount = new Set(recalls.map((r) => r.brand)).size;

// Newest first.
const sortedRecalls = [...recalls].sort((a, b) => (b.updatedDate || b.recallDate).localeCompare(a.updatedDate || a.recallDate));
const lastUpdated = sortedRecalls[0] ? (sortedRecalls[0].updatedDate || sortedRecalls[0].recallDate) : '';
const latest = sortedRecalls[0];

// Group by year (of the display date) for scannable list sections.
const yearGroups: [string, { recall: (typeof sortedRecalls)[0]; index: number }[]][] = [];
let rowIndex = 0;
for (const recall of sortedRecalls) {
	const year = (recall.updatedDate || recall.recallDate).slice(0, 4);
	let group = yearGroups.find(([y]) => y === year);
	if (!group) {
		group = [year, []];
		yearGroups.push(group);
	}
	group[1].push({ recall, index: rowIndex++ });
}

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Pet Food Recall Database',
	numberOfItems: recalls.length,
	itemListElement: sortedRecalls.map((r, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: `${r.brand} — ${r.product}`,
		url: `${SITE_URL}/tools/pet-recall-checker/${r.slug}/`,
	})),
};
---

<Page title={title} description={description} image={image} breadcrumbs={breadcrumbs} wide={true} compactHeader={true} showNewsletter={false}>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} slot="head" />

	{latest && (
		<a class="recall-latest" href={`/tools/pet-recall-checker/${latest.slug}/`}>
			<span class="recall-latest-tag">Latest {statusLabel[latest.status].toLowerCase()}</span>
			<span class="recall-latest-text"><strong>{latest.brand}</strong>: {latest.product}</span>
			<span class="recall-latest-date">{fmtDate(latest.updatedDate || latest.recallDate)}</span>
		</a>
	)}

	<section class="recall-search" aria-label="Recall search">
		<div class="recall-search-box">
			<svg class="recall-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="8" />
				<line x1="21" y1="21" x2="16.65" y2="16.65" />
			</svg>
			<input
				type="search"
				id="recall-search-input"
				class="recall-search-input"
				placeholder="Search by brand, product, or lot code — e.g. Pedigree, Quest, 613C3KKCFC"
				autocomplete="off"
				aria-label="Search recalls by brand, product, or lot code"
			/>
		</div>
		<p class="recall-stats">
			<strong>{recalls.length}</strong> recall records · <strong>{brandCount}</strong> brands covered · Sourced from FDA notices · Updated weekly
		</p>
	</section>

	<div class="recall-filters">
		<div class="recall-filter-row">
			<div class="recall-filter-group" aria-label="Filter by pet type">
				{speciesFilters.map((f) => (
					<label class="recall-pill">
						<input type="radio" name="species" value={f.slug} checked={f.slug === 'all'} />
						<span>{f.label}</span>
					</label>
				))}
			</div>
			<label class="recall-select-wrap">
				<span class="recall-select-label">Hazard</span>
				<select id="hazard-select" aria-label="Filter by hazard">
					<option value="all">Every hazard</option>
					{hazardOptions.map((h) => <option value={h}>{h}</option>)}
				</select>
			</label>
		</div>
		<div class="recall-filter-group" aria-label="Filter by status">
			<span class="recall-filter-label">Status:</span>
			{statusFilters.map((f) => (
				<label class="recall-pill">
					<input type="radio" name="status" value={f.slug} checked={f.slug === 'all'} />
					<span>{f.label}</span>
				</label>
			))}
		</div>
	</div>

	<p class="recall-meta">
		<span id="recall-result-count" aria-live="polite" role="status"></span>
		<span class="recall-updated">Latest entry: {lastUpdated} · always confirm against the linked FDA notice.</span>
	</p>

	<section id="recall-results" class="recall-results" aria-label="Recall results">
		{yearGroups.map(([year, items]) => (
			<div class="recall-year-group">
				<div class="recall-year-head" data-year={year}>{year}</div>
				{items.map(({ recall: r, index }) => {
					const displayDate = r.updatedDate || r.recallDate;
					const metaLots = r.lotCodes.length > 0 ? ` · Lots: ${r.lotCodes.slice(0, 2).join(', ')}${r.lotCodes.length > 2 ? '…' : ''}` : '';
					return (
						<a
							class="recall-row"
							href={`/tools/pet-recall-checker/${r.slug}/`}
							data-index={index}
							data-year={year}
							data-slug={r.slug}
							data-search={`${r.brand} ${r.product} ${r.aliases.join(' ')} ${r.company} ${r.hazard} ${r.hazardDetail}`.toLowerCase()}
							data-lots={r.lotCodes.join(' ').toLowerCase()}
							data-status={r.status}
							data-hazard={hazardBucket(r.hazard)}
							data-species={r.species.join(' ')}
						>
							<span class={`recall-tile tile--${r.category}`} aria-hidden="true">{r.brand.charAt(0)}</span>
							<span class="recall-row-main">
								<span class="recall-row-top">
									<span class="recall-brand">{r.brand}</span>
									<span class={`recall-status recall-status--${r.status}`}>{statusLabel[r.status]}</span>
								</span>
								<span class="recall-product">{r.product}</span>
								<span class="recall-row-meta">
									{r.hazard} · {categoryLabel[r.category]}{metaLots}
									<span class="recall-date-mobile"> · {fmtDate(displayDate)}</span>
								</span>
							</span>
							<span class="recall-row-date">
								<span class="recall-date">{fmtDate(displayDate)}</span>
								{r.updatedDate && <span class="recall-date-note">updated {fmtDate(r.updatedDate)}</span>}
							</span>
						</a>
					);
				})}
			</div>
		))}

		<button id="recall-load-more" class="recall-load-more" type="button" hidden>
			Show older notices
		</button>

		<div id="recall-empty" class="recall-empty" hidden>
			<h2 id="recall-empty-title">No recall found</h2>
			<p id="recall-empty-body">
				Good news — no verified recall matches that search. This database covers verified FDA actions
				from 2025 onward; it is updated weekly. Always double-check the
				<a href="https://www.fda.gov/animal-veterinary/safety-health/recalls-withdrawals" target="_blank" rel="noopener">FDA recalls page</a> for the very latest.
			</p>
			<div class="recall-empty-hotlines">
				<p class="text-muted">If your pet already ate something you're worried about — recalled or not — call a professional:</p>
				<PoisonHotlines compact={true} />
			</div>
		</div>
	</section>

	<ToxinDisclaimer lead="This tool indexes official recall notices — it is not itself an official notice." />

	<NewsletterForm
		title="Hear about a recall before your store does"
		description="We check FDA notices weekly. Get new pet food recalls and advisories in your inbox."
		buttonText="Send me recall alerts"
	/>

	<script is:inline>
		(function () {
			const PAGE_SIZE = 30;
			const rows = Array.from(document.querySelectorAll('.recall-row'));
			const yearHeads = Array.from(document.querySelectorAll('.recall-year-head'));
			const input = document.getElementById('recall-search-input');
			const hazardSelect = document.getElementById('hazard-select');
			const empty = document.getElementById('recall-empty');
			const emptyTitle = document.getElementById('recall-empty-title');
			const countEl = document.getElementById('recall-result-count');
			const loadBtn = document.getElementById('recall-load-more');
			let revealed = PAGE_SIZE;

			function currentFilter(name) {
				const checked = document.querySelector('input[name="' + name + '"]:checked');
				return checked ? checked.value : 'all';
			}

			// Lot-code matching: exact or prefix match in either direction,
			// so "613C3" finds "613C3KKCFC" and a full code finds itself.
			function lotMatches(rowLots, query) {
				if (!rowLots) return false;
				const q = query.replace(/\s+/g, '');
				if (q.length < 3) return false; // 1-2 chars are too vague to be a lot fragment
				return rowLots.split(' ').some((lot) => {
					const l = lot.replace(/\s+/g, '');
					return l === q || l.startsWith(q) || q.startsWith(l);
				});
			}

			function applyFilters() {
				const query = (input.value || '').trim().toLowerCase();
				const species = currentFilter('species');
				const status = currentFilter('status');
				const hazard = hazardSelect ? hazardSelect.value : 'all';

				let visible = 0;
				rows.forEach((row) => {
					const text = row.dataset.search || '';
					const matchesQuery =
						query === '' ||
						text.includes(query) ||
						lotMatches(row.dataset.lots || '', query);
					const matchesSpecies = species === 'all' || (row.dataset.species || '').split(' ').indexOf(species) !== -1;
					const matchesStatus = status === 'all' || row.dataset.status === status;
					const matchesHazard = hazard === 'all' || row.dataset.hazard === hazard;
					const withinLimit = Number(row.dataset.index) < revealed;

					const show = matchesQuery && matchesSpecies && matchesStatus && matchesHazard && withinLimit;
					row.hidden = !show;
					if (show) visible++;
				});

				// Hide year headers whose group has no visible rows.
				yearHeads.forEach((head) => {
					const year = head.dataset.year;
					const anyVisible = rows.some((row) => row.dataset.year === year && !row.hidden);
					head.hidden = !anyVisible;
				});

				countEl.textContent = 'Showing ' + visible + ' of ' + rows.length + ' notices.';
				empty.hidden = visible !== 0;
				if (visible === 0 && query) {
					emptyTitle.textContent = 'No recall found for "' + query + '"';
				} else if (visible === 0) {
					emptyTitle.textContent = 'No recalls match these filters';
				}
				if (loadBtn) loadBtn.hidden = revealed >= rows.length;
			}

			let debounceTimer;
			input?.addEventListener('input', () => {
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(applyFilters, 120);
			});
			document.querySelectorAll('input[name="status"], input[name="species"]').forEach((el) => {
				el.addEventListener('change', applyFilters);
			});
			hazardSelect?.addEventListener('change', applyFilters);
			loadBtn?.addEventListener('click', () => {
				revealed += PAGE_SIZE;
				applyFilters();
			});

			// Pre-fill from ?q= for shareable links.
			const params = new URLSearchParams(window.location.search);
			const initialQuery = params.get('q');
			if (initialQuery) input.value = initialQuery;
			applyFilters();
		})();
	</script>
</Page>

<style>
	/* Latest-alert banner */
	.recall-latest {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-sm);
		padding: 0.8rem 1.25rem;
		margin-bottom: var(--spacing-lg);
		background-color: hsl(var(--secondary) / 0.08);
		border: 1px solid hsl(var(--secondary) / 0.35);
		border-radius: 16px;
		text-decoration: none;
		color: hsl(var(--foreground));
		transition: border-color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
	}

	.recall-latest:hover {
		border-color: hsl(var(--secondary) / 0.6);
		background-color: hsl(var(--secondary) / 0.12);
		text-decoration: none;
	}

	.recall-latest-tag {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: hsl(var(--secondary-dark));
		background-color: hsl(var(--secondary) / 0.16);
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	.recall-latest-text {
		flex: 1;
		min-width: 0;
		font-size: 0.95rem;
	}

	.recall-latest-date {
		font-size: 0.85rem;
		color: hsl(var(--muted-foreground));
		white-space: nowrap;
	}

	/* Search */
	.recall-search-box {
		position: relative;
	}

	.recall-search-icon {
		position: absolute;
		left: var(--spacing-md);
		top: 50%;
		transform: translateY(-50%);
		width: 1.4rem;
		height: 1.4rem;
		color: hsl(var(--muted-foreground));
		pointer-events: none;
	}

	.recall-search-input {
		width: 100%;
		height: 3.5rem;
		padding: 0 var(--spacing-lg) 0 3.25rem;
		font-size: 1.05rem;
		border: 1px solid hsl(var(--border));
		border-radius: 16px;
		background-color: hsl(var(--card));
		color: hsl(var(--foreground));
		box-shadow: 0 10px 30px hsl(var(--foreground) / 0.06);
		transition: border-color var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out);
	}

	.recall-search-input:focus {
		outline: none;
		border-color: hsl(var(--primary));
		box-shadow: 0 0 0 3px hsl(var(--primary) / 0.15), 0 10px 30px hsl(var(--foreground) / 0.06);
	}

	.recall-stats {
		margin: var(--spacing-sm) 0 0;
		font-size: 0.9rem;
		color: hsl(var(--muted-foreground));
	}

	.recall-stats strong {
		color: hsl(var(--foreground));
	}

	/* Filters */
	.recall-filters {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-lg);
		margin-bottom: var(--spacing-md);
	}

	.recall-filter-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-sm);
	}

	.recall-filter-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-xs);
	}

	.recall-filter-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: hsl(var(--muted-foreground));
		margin-right: var(--spacing-xs);
	}

	.recall-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid hsl(var(--border));
		border-radius: 9999px;
		padding: 0.35rem 0.85rem;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		background-color: hsl(var(--card));
		color: hsl(var(--foreground));
		transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out);
	}

	.recall-pill:hover {
		border-color: hsl(var(--primary));
		background-color: hsl(var(--primary) / 0.05);
	}

	.recall-pill input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}

	.recall-pill:has(input:checked) {
		border-color: hsl(var(--primary));
		background-color: hsl(var(--primary));
		color: hsl(var(--primary-foreground));
	}

	.recall-select-wrap {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
	}

	.recall-select-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: hsl(var(--muted-foreground));
	}

	.recall-select-wrap select {
		height: 2.4rem;
		padding: 0 2rem 0 0.9rem;
		font-size: 0.9rem;
		color: hsl(var(--foreground));
		background-color: hsl(var(--card));
		border: 1px solid hsl(var(--border));
		border-radius: 9999px;
		cursor: pointer;
	}

	/* Result meta line */
	.recall-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--spacing-xs);
		font-size: 0.9rem;
		color: hsl(var(--muted-foreground));
		margin-bottom: var(--spacing-md);
	}

	.recall-updated {
		font-size: 0.8rem;
	}

	/* Compact list rows */
	.recall-results {
		display: flex;
		flex-direction: column;
	}

	.recall-year-head {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--muted-foreground));
		padding: var(--spacing-md) var(--spacing-sm) var(--spacing-xs);
		border-bottom: 1px solid hsl(var(--border));
	}

	.recall-year-head[hidden] {
		display: none;
	}

	.recall-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-md) var(--spacing-sm);
		border-bottom: 1px solid hsl(var(--border));
		text-decoration: none;
		color: hsl(var(--foreground));
		transition: background-color var(--dur-short) var(--ease-out);
	}

	.recall-row:hover {
		background-color: hsl(var(--primary) / 0.04);
		text-decoration: none;
	}

	.recall-row[hidden] {
		display: none;
	}

	.recall-tile {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-md);
		font-size: 1.3rem;
		font-weight: 700;
	}

	.tile--dog-food,
	.tile--dog-treat {
		background-color: hsl(var(--primary) / 0.1);
		color: hsl(var(--primary));
	}

	.tile--cat-food {
		background-color: hsl(var(--secondary) / 0.14);
		color: hsl(var(--secondary-dark));
	}

	.tile--pet-food,
	.tile--supplement,
	.tile--other {
		background-color: hsl(var(--muted));
		color: hsl(var(--muted-foreground));
	}

	.recall-row-main {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.recall-row-top {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		flex-wrap: wrap;
	}

	.recall-brand {
		font-weight: 700;
		font-size: 1rem;
	}

	.recall-status {
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.15rem 0.55rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	.recall-status--active {
		background-color: hsl(var(--tox-severe) / 0.12);
		color: hsl(var(--tox-severe));
	}

	.recall-status--fda-advisory {
		background-color: hsl(var(--tox-moderate) / 0.14);
		color: hsl(var(--tox-moderate));
	}

	.recall-status--terminated {
		background-color: hsl(var(--muted));
		color: hsl(var(--muted-foreground));
	}

	.recall-product {
		font-size: 0.95rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.recall-row-meta {
		font-size: 0.85rem;
		color: hsl(var(--muted-foreground));
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.recall-date-mobile {
