---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => (b.data.updatedDate || b.data.pubDate).valueOf() - (a.data.updatedDate || a.data.pubDate).valueOf()
);

const [featuredPost, ...restPosts] = posts;
const railPosts = restPosts.slice(0, 2);

const tools = [
	{
		href: '/tools/dog-age-calculator/',
		title: 'Dog Age Calculator',
		description: 'Human years by size — more accurate than the old 7-year rule.',
		icon: 'clock',
	},
	{
		href: '/tools/cat-age-calculator/',
		title: 'Cat Age Calculator',
		description: 'Human years using the Cornell-aligned 16-5-4 model.',
		icon: 'paw',
	},
	{
		href: '/tools/pet-toxin-lookup/',
		title: 'Pet Toxin Lookup',
		description: 'Check foods, plants, and household items for toxicity.',
		icon: 'shield',
	},
	{
		href: '/tools/pet-recall-checker/',
		title: 'Pet Food Recall Checker',
		description: 'Check your pet food by brand, product, or lot code.',
		icon: 'alert',
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Intro -->
			<section class="intro">
				<div class="container intro-grid">
					<div class="intro-content">
						<h1>Smarter Feeding Decisions for <span class="text-accent">Healthier&nbsp;Pets</span></h1>
						<p class="intro-subtitle">
							Honest product reviews and practical guides to help you choose the best food, bowls, and feeding routines for your furry family.
						</p>
						<div class="intro-cta">
							<a href="/blog/" class="btn btn-primary btn-lg">Explore Guides</a>
							<a href="/about/" class="btn btn-secondary btn-lg">How We Research</a>
						</div>
						<div class="intro-newsletter">
							<NewsletterForm
								title=""
								description="Join thousands of thoughtful pet owners. Get our free Dog Feeding Safety Checklist."
								buttonText="Get Free Checklist"
								compact={true}
							/>
						</div>
					</div>
					<div class="intro-image">
						<img src="/images/hero.jpg" alt="Pomeranian looking up beside a full bowl of kibble" fetchpriority="high" />
					</div>
				</div>
			</section>

			<!-- Latest -->
			<section class="latest section">
				<div class="container">
					<div class="rail-header">
						<h2>Latest</h2>
						<a href="/blog/" class="rail-more">View all articles →</a>
					</div>

					<article class="featured">
						<a href={`/blog/${featuredPost.id}/`} class="featured-link">
							<div class="featured-image">
								<img src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							</div>
							<div class="featured-content">
								{featuredPost.data.categories?.[0] && (
									<span class="badge badge-secondary">
										{featuredPost.data.categories[0].replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase())}
									</span>
								)}
								<h3>{featuredPost.data.title}</h3>
								<p class="text-muted">{featuredPost.data.description}</p>
								<span class="rail-more">Read it →</span>
							</div>
						</a>
					</article>

					<div class="rail-grid">
						{railPosts.map((post) => (
							<article class="rail-item">
								<a href={`/blog/${post.id}/`} class="rail-item-link">
									<h3>{post.data.title}</h3>
									<p class="text-muted">{post.data.description}</p>
									<span class="rail-more">Read it →</span>
								</a>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- Tools -->
			<section class="tools section-sm bg-surface">
				<div class="container">
					<div class="rail-header">
						<h2>Free tools</h2>
					</div>
					<div class="tool-grid">
						{tools.map((tool) => (
							<a href={tool.href} class="tool-card">
								<div class="tool-head">
									<span class="tool-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											{tool.icon === 'clock' && (
												<>
													<circle cx="12" cy="12" r="10"/>
													<polyline points="12 6 12 12 16 14"/>
												</>
											)}
											{tool.icon === 'paw' && (
												<>
													<circle cx="12" cy="13" r="3" />
													<circle cx="6.5" cy="9.5" r="1.8" />
													<circle cx="17.5" cy="9.5" r="1.8" />
													<path d="M12 16c-2.6 0-4.5 1.8-4.5 4h9c0-2.2-1.9-4-4.5-4z" />
												</>
											)}
											{tool.icon === 'shield' && (
												<>
													<path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3Z" />
													<path d="M12 8v6" />
													<path d="M9 11h6" />
												</>
											)}
											{tool.icon === 'alert' && (
												<>
													<path d="M12 9v4" />
													<path d="M12 17h.01" />
													<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
												</>
											)}
										</svg>
									</span>
									<h3>{tool.title}</h3>
								</div>
								<p class="text-muted">{tool.description}</p>
								<span class="card-link">Try it →</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Research process -->
			<section class="research section">
				<div class="container research-grid">
					<div class="research-image">
						<img src="/images/about.jpg" alt="Beagle waiting patiently by a feeding bowl" loading="lazy" />
					</div>
					<div class="research-content">
						<h2>How We Choose What to Recommend</h2>
						<p class="text-muted research-intro">
							Every guide starts with real data and ends with advice we would follow for our own pets.
						</p>
						<ol class="research-steps">
							<li>Analyze verified reviews from Amazon, Chewy, and Reddit</li>
							<li>Compare product specs, materials, and safety standards</li>
							<li>Consult veterinary sources and feeding research</li>
							<li>Test products hands-on when possible</li>
							<li>Update guides regularly as new products launch</li>
						</ol>
						<a href="/about/" class="btn btn-secondary">Learn More</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Intro — asymmetric 7/5, plain paper */
	.intro {
		padding: var(--spacing-2xl) 0 var(--spacing-xl);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--spacing-3xl);
		align-items: stretch;
	}

	.intro-image {
		display: flex;
	}

	.intro-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-lg);
	}

	.intro-content h1 {
		margin-bottom: var(--spacing-md);
		max-width: 18ch;
		font-size: clamp(2.1rem, 3.6vw, 3.25rem);
		font-weight: 600;
		line-height: 1.12;
	}

	.text-accent {
		color: hsl(var(--primary));
	}

	.intro-subtitle {
		font-size: 1.15rem;
		color: hsl(var(--muted-foreground));
		margin-bottom: var(--spacing-lg);
		max-width: 50ch;
		line-height: 1.7;
	}

	.intro-cta {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
		margin-bottom: var(--spacing-lg);
	}

	.intro-newsletter {
		padding-top: var(--spacing-md);
		max-width: 480px;
	}

	/* Section dividers — ONE divider vocabulary: a container-width hairline at each
	   major section boundary, but only where no other separation exists (Free tools
	   uses its surface band, so Research after it gets no line). No rules inside
	   lists, bands, or cards. */
	.latest .container {
		border-top: 1px solid hsl(var(--border));
		padding-top: var(--spacing-2xl);
	}

	/* Rail headers — whitespace rhythm, no rules */
	.rail-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-lg);
	}

	.rail-header h2 {
		margin: 0;
	}

	.rail-more {
		font-weight: 600;
		font-size: 0.9rem;
		color: hsl(var(--primary));
		white-space: nowrap;
	}

	/* Latest — featured + 2-up rail (asymmetric) */
	.latest {
		padding-top: var(--spacing-2xl);
		padding-bottom: var(--spacing-xl);
	}

	.featured {
		margin-bottom: var(--spacing-xl);
	}

	.featured-link {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: var(--spacing-xl);
		align-items: center;
		color: hsl(var(--foreground));
	}

	.featured-link:hover {
		text-decoration: none;
	}

	.featured-image {
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	.featured-image img {
		width: 100%;
		height: 320px;
		object-fit: cover;
		border-radius: 0;
		transition: transform var(--dur-med) var(--ease-out);
	}

	.featured-link:hover .featured-image img {
		transform: scale(1.02);
	}

	.featured-content h3 {
		font-size: 1.6rem;
		line-height: 1.25;
		margin: var(--spacing-sm) 0;
	}

	.featured-content p {
		margin-bottom: var(--spacing-md);
	}

	.rail-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-xl);
	}

	.rail-item {
		padding-top: 0;
	}

	.rail-item-link {
		color: hsl(var(--foreground));
		display: block;
	}

	.rail-item-link:hover {
		text-decoration: none;
	}

	.rail-item-link:hover h3 {
		color: hsl(var(--primary));
	}

	.rail-item h3 {
		font-size: 1.2rem;
		line-height: 1.35;
		margin-bottom: var(--spacing-sm);
		transition: color var(--dur-short) var(--ease-out);
	}

	.rail-item p {
		font-size: 0.95rem;
		margin-bottom: var(--spacing-sm);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-link {
		font-size: 0.9rem;
		font-weight: 600;
		color: hsl(var(--primary));
	}

	/* Tools — compact cards, icon inline with title */
	.tool-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
	}

	.tool-card {
		background-color: hsl(var(--card));
		border: 1px solid hsl(var(--border));
		border-radius: var(--radius-card);
		padding: var(--spacing-lg);
		color: hsl(var(--foreground));
		transition: border-color var(--dur-short) var(--ease-out);
	}

	.tool-card:hover {
		text-decoration: none;
		border-color: hsl(var(--primary) / 0.4);
	}

	.tool-head {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-sm);
	}

	.tool-head h3 {
		font-size: 1.15rem;
		margin: 0;
	}

	.tool-icon {
		width: 2.25rem;
		height: 2.25rem;
		flex-shrink: 0;
		background-color: hsl(var(--primary) / 0.1);
		color: hsl(var(--primary));
		border-radius: var(--radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tool-icon svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.tool-card p {
		font-size: 0.9rem;
		margin: 0 0 var(--spacing-md);
	}

	/* Research process */
	.research-grid {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: var(--spacing-3xl);
		align-items: center;
	}

	.research-intro {
		font-size: 1.1rem;
		max-width: 45ch;
	}

	.research-image img {
		width: 100%;
		max-height: 450px;
		object-fit: cover;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
	}

	.research-steps {
		padding-left: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	.research-steps li {
		font-size: 1rem;
		margin-bottom: var(--spacing-md);
		padding-left: var(--spacing-sm);
	}

	/* Responsive */
	@media (max-width: 992px) {
		.intro-grid,
		.research-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}

		.intro-image {
			order: -1;
		}

		.featured-link {
			grid-template-columns: 1fr;
		}

		.featured-image img {
			height: 240px;
		}
	}

	@media (max-width: 900px) {
		.tool-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.intro-content h1 {
			max-width: none;
		}

		.intro-cta {
			flex-direction: column;
		}

		.intro-cta .btn {
			width: 100%;
		}

		.rail-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
